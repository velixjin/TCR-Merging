# Machine-specific locations for TCR. Copy to `.env` (git-ignored) and fill in absolute paths:
#   cp .env.example .env
# Configs in configs/ refer to these as ${VAR}. Variables already exported in the shell take precedence.
# Use a different file with TCR_ENV_FILE=/path/to/file.

# pi0.5 base model and expert checkpoints: <root>/base, <root>/spatial, <root>/object, <root>/goal, <root>/long
TCR_CHECKPOINT_ROOT=/path/to/checkpoints

# Calibration caches: <root>/a/<suite>, <root>/b/<suite>, <root>/demo_a/<suite>, <root>/demo_b/<suite>
TCR_CACHE_ROOT=/path/to/caches

# Merged models and run outputs
TCR_OUTPUT_ROOT=/path/to/outputs

# Optional: LIBERO config directory (default ~/.libero) and the generated reset bank used by tests
# LIBERO_CONFIG_PATH=/path/to/.libero
# TCR_RESET_BANK=/path/to/banks/clean-v1
